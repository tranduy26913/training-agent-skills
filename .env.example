# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api
APP_BODY_SIZE_LIMIT=20mb

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=app_db

# Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# COBOL CGI Runner (GnuCOBOL + Node.js, replaces Apache CGI)
# Start: node cobol/cgi-runner/server.js (from project root)
# Build: cd cobol && C:\msys64\mingw64\bin\mingw32-make.exe all
COBOL_CGI_URL=http://localhost:8081/cgi-bin
COBOL_CGI_PORT=8081

# Client
VITE_API_BASE_URL=http://localhost:3000/api

# LLM Provider (Ollama / Mock)
# Used by the Python query worker for local or mock inference.
# Start the Ollama server: https://ollama.com
LLM_API_URL=http://localhost:11434
LLM_MODEL=llama3

# Gemini Provider (optional)
# Only required when sessions are created with llmProvider='gemini'.
# Leave blank (GEMINI_API_KEY=) to disable Gemini; Gemini provider will raise an error if called without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
