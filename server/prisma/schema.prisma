// Prisma schema for the auth + users + audit scope.
// Mirrors the existing MySQL schema (migrations 001, 004, 005) so the generated
// client matches columns used by application code.
//
// NOTE: This file is auto-generated from the files in ./schema/.
// Do not edit this file directly; edit the per-table files and run:
//   node scripts/merge-schema.js
// このファイルは ./schema/ 内のファイルから自動生成されます。
// 直接編集せず、テーブルごとのファイルを編集して上記コマンドを実行してください。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User account. role / status are stored as strings (MySQL enums) to keep
// parity with the existing column types and avoid Prisma enum migrations.
model User {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  password     String    @db.VarChar(255)
  role         String    @default("user") @db.VarChar(20)
  status       String    @default("active") @db.VarChar(20)
  avatar       String?   @db.VarChar(500)
  // [NEW] fields added by migration 005
  lastLoginAt  DateTime? @map("last_login_at")
  points       Int       @default(0)
  note         String?   @db.VarChar(500)
  birthday     DateTime? @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Audit log relations (admin performing actions, target user receiving them)
  auditLogsAsAdmin   AuditLog[] @relation("AuditLogAdmin")
  auditLogsAsTarget  AuditLog[] @relation("AuditLogTarget")

  // Projects owned by this user
  projects Project[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// Audit log entry. changed_fields is stored as JSON in MySQL.
model AuditLog {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  adminId         Int      @map("admin_id") @db.UnsignedInt
  targetUserId    Int      @map("target_user_id") @db.UnsignedInt
  action          String   @db.VarChar(20)
  changedFields   Json?    @map("changed_fields")
  timestamp       DateTime @default(now()) @db.DateTime(0)

  admin   User @relation("AuditLogAdmin",  fields: [adminId],      references: [id], onDelete: Cascade)
  target  User @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@map("audit_logs")
}

// Roles reference table (seeded by 001_seed_roles.sql). Kept here so admin
// checks can be added in a future migration without breaking the client.
model Role {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("roles")
}

// Settings key/value store (migration 003). Out of immediate use but kept in
// schema so it is discoverable and not lost.
model Setting {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  group     String   @default("general") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

// Project AI Content Generation management.
// Soft delete via isDeleted flag; hidden fields (headline, caption, subtext)
// reserved for future use.
model Project {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  projectPrompt String?  @map("project_prompt") @db.Text
  headline      String?  @db.Text
  caption       String?  @db.Text
  subtext       String?  @db.Text
  ownerId       Int      @map("owner_id") @db.UnsignedInt
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([isDeleted])
  @@map("projects")
}
