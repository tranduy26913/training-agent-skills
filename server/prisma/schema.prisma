// Canonical Prisma schema for the Japanese learning platform.
// Edit this file directly and create a migration for every database change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  email       String    @unique @db.VarChar(255)
  password    String    @db.VarChar(255)
  role        String    @default("user") @db.VarChar(20)
  status      String    @default("active") @db.VarChar(20)
  avatar      String?   @db.VarChar(500)
  lastLoginAt DateTime? @map("last_login_at")
  points      Int       @default(0)
  note        String?   @db.VarChar(500)
  birthday    DateTime? @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  auditLogsAsAdmin    AuditLog[]         @relation("AuditLogAdmin")
  auditLogsAsTarget   AuditLog[]         @relation("AuditLogTarget")
  vocabulariesCreated Vocabulary[]       @relation("VocabularyCreatedBy")
  vocabulariesUpdated Vocabulary[]       @relation("VocabularyUpdatedBy")
  coursesCreated      Course[]           @relation("CourseCreatedBy")
  enrollments         CourseEnrollment[]
  lessonProgress      LessonProgress[]
  quizAttempts        QuizAttempt[]
  learningSessions    LearningSession[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Vocabulary {
  id            Int      @id @default(autoincrement())
  kanji         String   @db.VarChar(255)
  hiragana      String?  @db.VarChar(255)
  romaji        String?  @db.VarChar(255)
  meaningVi     String   @map("meaning_vi") @db.VarChar(1000)
  onYomi        String?  @map("on_yomi") @db.VarChar(255)
  level         String   @default("N5") @db.VarChar(20)
  mediaUrl      String?  @map("media_url") @db.VarChar(500)
  note          String?
  tags          Json
  status        String   @default("draft") @db.VarChar(20)
  createdById   Int      @map("created_by_id")
  updatedById   Int?     @map("updated_by_id")
  version       Int      @default(1)
  learnCount    Int      @default(0) @map("learn_count")
  favoriteCount Int      @default(0) @map("favorite_count")
  reportCount   Int      @default(0) @map("report_count")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  createdBy User  @relation("VocabularyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User? @relation("VocabularyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([kanji])
  @@index([level])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
  @@index([isDeleted])
  @@map("vocabularies")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  adminId       Int      @map("admin_id")
  targetUserId  Int      @map("target_user_id")
  action        String   @db.VarChar(20)
  changedFields Json?    @map("changed_fields")
  timestamp     DateTime @default(now())

  admin  User @relation("AuditLogAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  target User @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@map("audit_logs")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String
  group     String   @default("general") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("roles")
}

model Course {
  id          Int                @id @default(autoincrement())
  slug        String             @unique @db.VarChar(160)
  title       String             @db.VarChar(200)
  description String?
  level       String             @default("N5") @db.VarChar(20)
  status      String             @default("draft") @db.VarChar(20)
  createdById Int                @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  createdBy   User               @relation("CourseCreatedBy", fields: [createdById], references: [id])
  units       Unit[]
  enrollments CourseEnrollment[]

  @@index([level, status])
  @@map("courses")
}

model Unit {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  title     String   @db.VarChar(200)
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@unique([courseId, position])
  @@map("units")
}

model Lesson {
  id        Int              @id @default(autoincrement())
  unitId    Int              @map("unit_id")
  title     String           @db.VarChar(200)
  summary   String?
  position  Int
  status    String           @default("draft") @db.VarChar(20)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sections  LessonSection[]
  progress  LessonProgress[]
  quizzes   Quiz[]

  @@unique([unitId, position])
  @@map("lessons")
}

model LessonSection {
  id       Int     @id @default(autoincrement())
  lessonId Int     @map("lesson_id")
  type     String  @db.VarChar(30)
  title    String? @db.VarChar(200)
  content  Json
  position Int
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@map("lesson_sections")
}

model CourseEnrollment {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  courseId   Int      @map("course_id")
  status     String   @default("active") @db.VarChar(20)
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

model LessonProgress {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  lessonId    Int       @map("lesson_id")
  status      String    @default("not_started") @db.VarChar(20)
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Quiz {
  id        Int           @id @default(autoincrement())
  lessonId  Int           @map("lesson_id")
  title     String        @db.VarChar(200)
  passScore Int           @default(70) @map("pass_score")
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id       Int    @id @default(autoincrement())
  quizId   Int    @map("quiz_id")
  type     String @db.VarChar(30)
  prompt   Json
  position Int
  answer   Json
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, position])
  @@map("questions")
}

model QuizAttempt {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  quizId      Int       @map("quiz_id")
  score       Int?
  submittedAt DateTime? @map("submitted_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model LearningSession {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_sessions")
}
