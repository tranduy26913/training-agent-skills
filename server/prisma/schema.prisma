// Prisma schema for the auth + users + audit scope.
// Mirrors the existing MySQL schema (migrations 001, 004, 005) so the generated
// client matches columns used by application code. Other modules (employees,
// notebooklm, vocabulary) keep using mysql2 directly and are out of scope.
//
// NOTE: This file is auto-generated from the files in ./schema/.
// Do not edit this file directly; edit the per-table files and run:
//   node scripts/merge-schema.js
// このファイルは ./schema/ 内のファイルから自動生成されます。
// 直接編集せず、テーブルごとのファイルを編集して上記コマンドを実行してください。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User account. role / status are stored as strings (MySQL enums) to keep
// parity with the existing column types and avoid Prisma enum migrations.
model User {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  password     String    @db.VarChar(255)
  role         String    @default("user") @db.VarChar(20)
  status       String    @default("active") @db.VarChar(20)
  avatar       String?   @db.VarChar(500)
  // [NEW] fields added by migration 005
  lastLoginAt  DateTime? @map("last_login_at")
  points       Int       @default(0)
  note         String?   @db.VarChar(500)
  birthday     DateTime? @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Audit log relations (admin performing actions, target user receiving them)
  auditLogsAsAdmin   AuditLog[] @relation("AuditLogAdmin")
  auditLogsAsTarget  AuditLog[] @relation("AuditLogTarget")

  @@index([role])
  @@index([status])
  @@map("users")
}

// Audit log entry. changed_fields is stored as JSON in MySQL.
model AuditLog {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  adminId         Int      @map("admin_id") @db.UnsignedInt
  targetUserId    Int      @map("target_user_id") @db.UnsignedInt
  action          String   @db.VarChar(20)
  changedFields   Json?    @map("changed_fields")
  timestamp       DateTime @default(now()) @db.DateTime(0)

  admin   User @relation("AuditLogAdmin",  fields: [adminId],      references: [id], onDelete: Cascade)
  target  User @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@map("audit_logs")
}

// Roles reference table (seeded by 001_seed_roles.sql). Kept here so admin
// checks can be added in a future migration without breaking the client.
model Role {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("roles")
}

// Settings key/value store (migration 003). Out of immediate use but kept in
// schema so it is discoverable and not lost.
model Setting {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  group     String   @default("general") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

// Vocabulary main table. Mirrors migration 011.
model Vocabulary {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  kanji          String   @db.VarChar(255)
  hiragana       String?  @db.VarChar(255)
  romaji         String?  @db.VarChar(255)
  meaningVi      String   @map("meaning_vi") @db.Text
  onYomi         String?  @map("on_yomi") @db.VarChar(255)
  level          String?  @db.VarChar(2)
  mediaUrl       String?  @map("media_url") @db.VarChar(500)
  note           String?  @db.Text
  // JSON column holding ["tag1", "tag2"].
  tags           Json?
  status         String   @default("Publish") @db.VarChar(10)
  learnCount     Int      @default(0) @map("learn_count") @db.UnsignedInt
  favoriteCount  Int      @default(0) @map("favorite_count") @db.UnsignedInt
  createdBy      Int?     @map("created_by") @db.UnsignedInt
  updatedBy      Int?     @map("updated_by") @db.UnsignedInt
  version        Int      @default(1) @db.UnsignedInt
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  relations      VocabRelation[]      @relation("VocabSource")
  relationsFrom  VocabRelation[]      @relation("VocabTarget")
  changeLogs     VocabChangeLog[]
  reports        VocabReport[]

  @@index([kanji])
  @@index([level])
  @@index([status])
  @@index([createdBy])
  @@map("vocabularies")
}

// Self-referencing table for vocabulary relations.
model VocabRelation {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  vocabId       Int      @map("vocab_id") @db.UnsignedInt
  targetVocabId Int      @map("target_vocab_id") @db.UnsignedInt
  relationType  String   @map("relation_type") @db.VarChar(10)
  createdAt     DateTime @default(now()) @map("created_at")

  vocab   Vocabulary @relation("VocabSource", fields: [vocabId],       references: [id], onDelete: Cascade)
  target  Vocabulary @relation("VocabTarget", fields: [targetVocabId], references: [id], onDelete: Cascade)

  @@unique([vocabId, targetVocabId, relationType])
  @@index([vocabId])
  @@index([targetVocabId])
  @@index([relationType])
  @@map("vocab_relations")
}

// Audit trail of vocabulary field changes.
model VocabChangeLog {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  vocabId      Int      @map("vocab_id") @db.UnsignedInt
  fieldName    String   @map("field_name") @db.VarChar(100)
  oldValue     String?  @map("old_value") @db.Text
  newValue     String?  @map("new_value") @db.Text
  changedBy    Int?     @map("changed_by") @db.UnsignedInt
  changeReason String?  @map("change_reason") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  vocab Vocabulary @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@index([vocabId])
  @@index([fieldName])
  @@map("vocab_change_logs")
}

// User reports for vocabulary entries.
model VocabReport {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  vocabId     Int       @map("vocab_id") @db.UnsignedInt
  reportText  String    @map("report_text") @db.Text
  status      String    @default("pending") @db.VarChar(10)
  reportedBy  Int       @map("reported_by") @db.UnsignedInt
  resolvedBy  Int?      @map("resolved_by") @db.UnsignedInt
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  vocab Vocabulary @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@index([vocabId])
  @@index([status])
  @@map("vocab_reports")
}

// NotebookLM workspace.
model Workspace {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @db.VarChar(255)
  description String?  @db.Text
  ownerId     Int      @map("owner_id") @db.UnsignedInt
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members  WorkspaceMember[]
  sessions ChatSession[]
  documents Document[]

  @@index([ownerId])
  @@index([name])
  @@map("workspaces")
}

// Membership: a user joined to a workspace with a role.
model WorkspaceMember {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  workspaceId Int      @map("workspace_id") @db.UnsignedInt
  userId      Int      @map("user_id") @db.UnsignedInt
  role        String   @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([role])
  @@map("workspace_members")
}

// Document attached to a workspace. file_data is BLOB and is omitted from the
// default selects to avoid pulling large binary payloads.
model Document {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  workspaceId Int     @map("workspace_id") @db.UnsignedInt
  uploadedBy Int      @map("uploaded_by") @db.UnsignedInt
  filename   String   @db.VarChar(500)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  fileSize   BigInt   @map("file_size") @db.UnsignedBigInt
  fileData   Bytes    @map("file_data") @db.LongBlob
  status     String   @default("pending") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@map("documents")
}

// Async background job. payload is a JSON document.
model Job {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  type         String    @db.VarChar(30)
  status       String    @default("pending") @db.VarChar(20)
  payload      Json
  retryCount   Int       @default(0) @map("retry_count") @db.UnsignedInt
  maxRetries   Int       @default(3) @map("max_retries") @db.UnsignedInt
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  steps        JobStep[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("jobs")
}

// A single step inside a Job.
model JobStep {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  jobId       Int       @map("job_id") @db.UnsignedInt
  stepName    String    @map("step_name") @db.VarChar(100)
  status      String    @default("pending") @db.VarChar(20)
  progressPct Int       @default(0) @map("progress_pct") @db.UnsignedTinyInt
  detail      String?   @db.Text
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@map("job_steps")
}

// Chat session scoped to a workspace and a user.
model ChatSession {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  workspaceId Int      @map("workspace_id") @db.UnsignedInt
  userId      Int      @map("user_id") @db.UnsignedInt
  title       String   @db.VarChar(255)
  llmProvider String   @default("ollama") @map("llm_provider") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([workspaceId])
  @@index([userId])
  @@index([updatedAt])
  @@map("chat_sessions")
}

// Single message inside a chat session.
model ChatMessage {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  sessionId Int      @map("session_id") @db.UnsignedInt
  role      String   @db.VarChar(20)
  content   String   @db.LongText
  sources   Json?
  jobId     Int?     @map("job_id") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([jobId])
  @@index([createdAt])
  @@map("chat_messages")
}

// Dead-letter queue entry: a job that exhausted its retries.
model DeadLetterJob {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  originalJobId  Int      @map("original_job_id") @db.UnsignedInt
  jobType        String   @map("job_type") @db.VarChar(50)
  payload        Json
  failureReason  String?  @map("failure_reason") @db.Text
  note           String?  @db.Text
  movedAt        DateTime @default(now()) @map("moved_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([originalJobId])
  @@index([jobType])
  @@index([movedAt])
  @@map("dead_letter_jobs")
}
