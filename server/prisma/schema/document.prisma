// Document attached to a workspace. file_data is BLOB and is omitted from the
// default selects to avoid pulling large binary payloads.
model Document {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  workspaceId Int     @map("workspace_id") @db.UnsignedInt
  uploadedBy Int      @map("uploaded_by") @db.UnsignedInt
  filename   String   @db.VarChar(500)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  fileSize   BigInt   @map("file_size") @db.UnsignedBigInt
  fileData   Bytes    @map("file_data") @db.LongBlob
  status     String   @default("pending") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@map("documents")
}
