// Dead-letter queue entry: a job that exhausted its retries.
model DeadLetterJob {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  originalJobId  Int      @map("original_job_id") @db.UnsignedInt
  jobType        String   @map("job_type") @db.VarChar(50)
  payload        Json
  failureReason  String?  @map("failure_reason") @db.Text
  note           String?  @db.Text
  movedAt        DateTime @default(now()) @map("moved_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([originalJobId])
  @@index([jobType])
  @@index([movedAt])
  @@map("dead_letter_jobs")
}
