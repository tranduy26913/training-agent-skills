// Script (kịch bản) management — belongs to a Project (1-N).
// Soft delete via isDeleted flag. AI model is NOT persisted —
// users select it per-generate request.
// スクリプト管理 — プロジェクトに属する（1対多）。
// ソフト削除は isDeleted フラグで行う。AIモデルは保存しない —
// 生成リクエストごとにユーザーが選択する。
model Script {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  title          String   @db.VarChar(200)
  idea           String   @db.Text
  characterCount Int      @map("character_count") @db.UnsignedInt
  minScenes      Int      @map("min_scenes") @db.UnsignedInt
  vibe           Json
  content        String?  @db.Text
  status         String   @default("draft") @db.VarChar(20)
  projectId      Int      @map("project_id") @db.UnsignedInt
  ownerId        Int      @map("owner_id") @db.UnsignedInt
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([ownerId])
  @@index([isDeleted])
  @@index([status])
  @@map("scripts")
}