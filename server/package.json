{
  "name": "server",
  "version": "1.0.0",
  "description": "Express.js backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "dev:debug": "nodemon --watch src --ext ts --ignore dist --exec \"node --inspect=9229 -r ts-node/register src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "schema:merge": "node prisma/scripts/merge-schema.js",
    "migrate": "ts-node src/database/migrate.ts",
    "migrate:test": "ts-node src/database/migrate.ts --test",
    "seed": "ts-node src/database/seed.ts",
    "seed:test": "ts-node src/database/seed.ts --test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "winston": "^3.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "nodemon": "^3.1.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.4"
  }
}
