{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@config": ["./config/index.ts"],
      "@models/*": ["./models/*"],
      "@middleware/*": ["./middleware/*"],
      "@database/*": ["./database/*"],
      "@utils/*": ["./utils/*"],
      "@types/*": ["./types/*"],
      "@modules/*": ["./modules/*"],
      "@core/*": ["./core/*"],
      "@types-express": ["./types/express.d.ts"],
      "@app": ["./app.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
