# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_BODY_SIZE_LIMIT=20mb
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL (Supavisor session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<encoded-password>@aws-<region>.pooler.supabase.com:5432/postgres

# Required only when running integration tests. Use a separate database.
DATABASE_URL_TEST=postgresql://postgres.<test-project-ref>:<encoded-password>@aws-<region>.pooler.supabase.com:5432/postgres

# Optional direct connection for administrative tooling on an IPv6-capable network.
DIRECT_URL=postgresql://postgres:<encoded-password>@db.<project-ref>.supabase.co:5432/postgres

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Seed account (used only by npm run seed)
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
